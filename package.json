{
  "name": "chatgpt-decision-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable inline decision widgets for ChatGPT Apps SDK conversations.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "npm run build:widget && npm run build:server",
    "build:widget": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "start:dev": "tsx src/server.ts",
    "test": "rm -rf .test-build && tsc -p tsconfig.core.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
